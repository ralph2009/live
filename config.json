{
  "output": {
    "m3u": "output/live.m3u",
    "txt": "output/live.txt",
    "stats": "output/stats.json",
    "epg": "https://live.fanmingming.cn/e.xml",
    "logo_base": "https://live.fanmingming.cn/tv/",
    "max_per_channel": 0,
    "txt_multi_url": true,
    "include_tvg_id": true,
    "variants": [
      {
        "name": "cctv-sat",
        "enabled": true,
        "desc": "只保留央视频道 + 卫视频道",
        "groups": [
          "央视频道",
          "卫视频道"
        ],
        "m3u": "output/cctv-sat.m3u",
        "txt": "output/cctv-sat.txt"
      }
    ]
  },
  "health": {
    "enabled": true,
    "concurrency": 64,
    "connect_timeout": 4,
    "read_timeout": 5,
    "test_per_channel": 0,
    "max_seconds": 1800,
    "drop_bad": true,
    "drop_status": [
      404,
      410,
      451
    ],
    "skip_ipv6_without_network": true,
    "output": "output/health.json",
    "summary": "output/health-summary.json"
  },
  "filters": {
    "promo_keywords": [
      "购物",
      "推广",
      "好物",
      "欢乐购",
      "导视",
      "精选",
      "优选",
      "严选",
      "秒杀",
      "抢购",
      "优惠",
      "折扣",
      "特价",
      "广告",
      "带货",
      "专场",
      "福利",
      "试看",
      "试用",
      "下单",
      "客服",
      "商城",
      "特卖",
      "团购",
      "促销",
      "招商",
      "加盟",
      "赔钱",
      "清仓",
      "9块9",
      "九块九",
      "包邮",
      "返利",
      "优惠券",
      "随心看",
      "欢乐生活",
      "热门推荐",
      "好物推荐",
      "支持作者",
      "打赏",
      "赞助",
      "捐助",
      "公众号",
      "交流群",
      "加群",
      "电报群"
    ],
    "blocked_groups": [
      "更新时间",
      "测试",
      "广告",
      "购物",
      "推广",
      "福利",
      "备用",
      "公告",
      "活动",
      "直播中国",
      "春晚频道"
    ],
    "blocked_name_patterns": [
      "^\\s*$",
      "^\\d+$"
    ],
    "blocked_url_patterns": [
      "/rtp/\\d{1,3}(\\.\\d{1,3}){3}:\\d+"
    ],
    "keep_foreign": true,
    "allowed_schemes": [
      "http",
      "https"
    ]
  },
  "sources": [
    {
      "name": "vbskycn-iptv4",
      "url": "https://raw.githubusercontent.com/vbskycn/iptv/master/tv/iptv4.m3u",
      "enabled": true,
      "priority": 1
    },
    {
      "name": "guovin-iptv-api",
      "url": "https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/result.m3u",
      "enabled": true,
      "priority": 2
    },
    {
      "name": "ttvv-iptv",
      "url": "https://raw.githubusercontent.com/ralph2009/ttvv/main/IPTV.txt",
      "enabled": true,
      "priority": 3
    },
    {
      "name": "fantaiying-live",
      "type": "tvbox",
      "urls": [
        "http://www.饭太硬.cc/tv",
        "http://fty.xxooo.cf/tv",
        "http://饭太硬.top/tv"
      ],
      "discover": [
        "http://www.饭太硬.cc/",
        "https://raw.githubusercontent.com/ngo5/IPTV/main/README.md",
        "https://raw.githubusercontent.com/gaotianliuyun/gao/master/README.md",
        "https://raw.githubusercontent.com/yoursmile66/TVBox/main/README.md"
      ],
      "enabled": true,
      "priority": 4,
      "remember": "data/endpoints.json"
    },
    {
      "name": "fanmingming-ipv4",
      "url": "https://raw.githubusercontent.com/fanmingming/live/main/tv/m3u/ipv4.m3u",
      "enabled": false,
      "priority": 2
    },
    {
      "name": "fanmingming-ipv6",
      "url": "https://raw.githubusercontent.com/fanmingming/live/main/tv/m3u/ipv6.m3u",
      "enabled": true,
      "priority": 8
    },
    {
      "name": "yuechan-live",
      "url": "https://raw.githubusercontent.com/yuechan/Live/main/IPTV.m3u",
      "enabled": true,
      "priority": 6
    },
    {
      "name": "iptv-org-cn",
      "url": "https://iptv-org.github.io/iptv/countries/cn.m3u",
      "enabled": false,
      "priority": 9
    }
  ],
  "fengcai": {
    "enabled": true,
    "url": "http://tvlive.fengcaizb.com/channels/gqds3.gz",
    "output_json": "output/channel-catalog.json",
    "output_txt": "output/channel-catalog.txt"
  },
  "logos": {
    "enabled": true,
    "ttl_days": 7,
    "cache": "data/logos.json",
    "auto_index": "data/auto-logos.json",
    "auto_base": "https://cdn.jsdelivr.net/gh/ralph2009/live@main/logos/"
  }
}
